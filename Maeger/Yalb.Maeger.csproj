<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Yalb</RootNamespace>
    <AssemblyName>Maeger</AssemblyName>
    <ApplicationIcon>Assets\Icon\Yalb.Maeger.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2420.47" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Splash\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="chrome-ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="pages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\Icon\Yalb.Maeger.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <!-- startpage build + distribution -->
    <StartpageSourceDir>$(MSBuildThisFileDirectory)..\startpage-src</StartpageSourceDir>
    <StartpageDistDir>$(StartpageSourceDir)\artifacts\startpage\dist</StartpageDistDir>
  </PropertyGroup>

  <!-- IMPORTANT:
       We intentionally do NOT build startpage automatically on every dotnet build.
       Instead, run explicitly:
         dotnet build -c Debug -t:BuildStartpageAndCopy
  -->

  <Target Name="EnsureStartpageNativeDeps">
    <PropertyGroup>
      <StartpageInstallScript>$(StartpageSourceDir)\scripts\install-windows-native.ps1</StartpageInstallScript>
    </PropertyGroup>

    <Message Importance="High"
             Text="Ensuring startpage native deps (lightningcss) via $(StartpageInstallScript)"
             Condition="Exists('$(StartpageInstallScript)')" />

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File "$(StartpageInstallScript)""
          Condition="Exists('$(StartpageInstallScript)')"
          ContinueOnError="false" />
  </Target>

  <Target Name="BuildStartpageAndCopy" DependsOnTargets="EnsureStartpageNativeDeps">
    <Message Importance="High" Text="Checking Node availability for startpage build..." />
    <Exec Command="node -e "process.exit(0)"" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>

    <Error Condition="'$(NodeExitCode)' != '0'"
           Text="Node.js is not available on PATH. Install Node 20.x and ensure 'node' is on PATH before building the startpage." />

    <Message Importance="High"
             Text="Running: pnpm --filter @workspace/startpage run build (working dir: $(StartpageSourceDir))" />

    <Exec Command="pnpm --filter @workspace/startpage run build"
          WorkingDirectory="$(StartpageSourceDir)"
          ContinueOnError="false" />

    <ItemGroup>
      <StartpageFiles Include="$(StartpageDistDir)\**\*.*" Condition="Exists('$(StartpageDistDir)')" />
    </ItemGroup>

    <Copy SourceFiles="@(StartpageFiles)"
          DestinationFiles="@(StartpageFiles->'$(OutDir)startpage\dist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="@(StartpageFiles) != ''" />


    <Message Importance="High" Text="Startpage built and copied to $(OutDir)startpage\dist" />
  </Target>

  <Target Name="CopySharedIconIntoProject">
    <PropertyGroup>
      <SharedIcon>$(MSBuildThisFileDirectory)..\\Assets\\Icon\\Yalb.Maeger.ico</SharedIcon>
      <LocalIconDir>$(MSBuildThisFileDirectory)Assets\\Icon\\</LocalIconDir>
      <LocalIcon>$(LocalIconDir)Yalb.Maeger.ico</LocalIcon>
    </PropertyGroup>

    <MakeDir Directories="$(LocalIconDir)" Condition="!Exists('$(LocalIconDir)')" />
    <Copy SourceFiles="$(SharedIcon)"
           DestinationFiles="$(LocalIcon)"
           SkipUnchangedFiles="true"
           Condition="Exists('$(SharedIcon)')" />
  </Target>

</Project>
