<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Yalb</RootNamespace>
    <AssemblyName>Maeger</AssemblyName>
    <ApplicationIcon>Assets\Icon\Yalb.Maeger.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2420.47" />
  </ItemGroup>
  
  <!-- This copies the manually-copied startpage\dist into the build output -->
  <ItemGroup>
    <Content Include="startpage\dist\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>startpage\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Optional: Automatically copy the latest Yas build into the project.
       Only runs if the Yas dist folder exists.  Remove this target if you
       prefer to copy manually. -->
  <Target Name="CopyYasStartpage" BeforeTargets="BeforeBuild"
          Condition="Exists('D:\ME\PC\Desktop\Workspace\Projects\Yalb\Yas\artifacts\startpage\dist\public')">
    <ItemGroup>
      <YasFiles Include="D:\ME\PC\Desktop\Workspace\Projects\Yalb\Yas\artifacts\startpage\dist\public\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(YasFiles)"
          DestinationFiles="@(YasFiles->'$(MSBuildProjectDirectory)\startpage\dist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied updated startpage from Yas." />
  </Target>

  <ItemGroup>
    <None Update="Splash\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="chrome-ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="pages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\Icon\Yalb.Maeger.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

